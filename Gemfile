source "https://rubygems.org"

# Local preview for a GitHub Pages Jekyll site (keeps plugin versions aligned with Pages).
gem "github-pages", group: :jekyll_plugins

# Needed to use `remote_theme:` locally.
gem "jekyll-remote-theme", group: :jekyll_plugins

# Minimal Mistakes uses `{% include_cached %}`.
gem "jekyll-include-cache", group: :jekyll_plugins

